# =====================================================================
# TrustVault — .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# =====================================================================

# ── Django ───────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts in production
# Example: DJANGO_ALLOWED_HOSTS=trustvault.example.com,www.trustvault.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL — required in production) ───────────────────
# Leave blank to use SQLite for local development
DB_ENGINE=django.db.backends.postgresql
DB_NAME=trustvault
DB_USER=trustvault_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the Django API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── File Storage ─────────────────────────────────────────────────────
# Absolute path to the directory where uploaded documents are stored.
# Must NOT be inside the frontend public directory.
MEDIA_ROOT=/var/trustvault/media

# ── Frontend ─────────────────────────────────────────────────────────
# Base URL of the Django API, used by the Vite frontend
VITE_API_BASE_URL=http://localhost:8000/api
